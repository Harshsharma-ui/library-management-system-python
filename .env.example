# SecureLib Environment Configuration Template
# Copy this file to .env and configure secrets accordingly

# Security: Generate a secure secret key using python: secrets.token_hex(32)
SECRET_KEY=securelib-college-minor-project-super-secret-key-change-in-prod-2026

# Flask Environment
FLASK_APP=run.py
FLASK_ENV=development
FLASK_DEBUG=1

# Database Configuration (SQLite default, can be swapped for PostgreSQL/MySQL)
DATABASE_URL=sqlite:///securelib.db

# Library Business Logic & Policy Configuration
DAILY_FINE_RATE=5.0
BORROW_DURATION_DAYS=14
MAX_BORROW_LIMIT=3
MAX_LOGIN_ATTEMPTS=5
LOCKOUT_DURATION_MINUTES=15
